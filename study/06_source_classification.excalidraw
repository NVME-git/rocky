    {
      "id": "r5xqt4p5",
      "type": "text",
      "x": 48,
      "y": 428,
      "width": 424,
      "height": 164,
      "angle": 0,
      "strokeColor": "#fef3c7",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
