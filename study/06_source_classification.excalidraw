    {
      "id": "flul1rsr",
      "type": "text",
      "x": 48,
      "y": 228,
      "width": 424,
      "height": 164,
      "angle": 0,
      "strokeColor": "#d1fae5",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
