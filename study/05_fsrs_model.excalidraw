      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Classification  (src/fsrs.rs \u2014 classify())\n\nR \u2265 0.9   \u2192  known\n0.7 \u2264 R < 0.9  \u2192  fading\nR < 0.7   \u2192  gap",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "ie0rnujj",
      "originalText": "Classification  (src/fsrs.rs \u2014 classify())\n\nR \u2265 0.9   \u2192  known\n0.7 \u2264 R < 0.9  \u2192  fading\nR < 0.7   \u2192  gap",
      "lineHeight": 1.4
    },
    {
      "id": "6qdy4lmc",
      "type": "rectangle",
