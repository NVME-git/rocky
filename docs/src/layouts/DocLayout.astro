---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';

const { title, activeSlug } = Astro.props as {
  title?: string;
  activeSlug?: string;
};

const base = import.meta.env.BASE_URL;
const pageTitle = title ? `${title} · Rocky` : 'Rocky · Personal Knowledge Graph';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content="A live 0–100 score of how well you actually understand the code your AI is shipping. Decays when you stop engaging. Climbs when you can answer for it." />

    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <link rel="manifest" href={`${base}manifest.json`} />
    <meta name="theme-color" content="#0A0E1A" />

    {/* Block FOUC: apply saved theme before first paint. */}
    <script is:inline>
      try {
        const t = localStorage.getItem('rocky-theme');
        if (t === 'light') document.documentElement.classList.add('light');
      } catch (_) {}
    </script>
  </head>
  <body>
    {/* Mobile-only top bar with hamburger + brand. */}
    <header class="topbar">
      <button id="nav-toggle" class="hamburger" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="primary-sidebar">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path fill="currentColor" d="M3 6h18v2H3V6zm0 5h18v2H3v-2zm0 5h18v2H3v-2z"/>
        </svg>
      </button>
      <a href={base} class="topbar-logo">
        <span class="topbar-mark">🪨</span>
        <span class="topbar-name">Rocky</span>
      </a>
    </header>

    {/* Tap-to-close backdrop, only active when sidebar is open on mobile. */}
    <div id="backdrop" class="backdrop" aria-hidden="true"></div>

    {/* Lightbox overlay — first click on an article image enlarges in-place;
        clicking the enlarged image (a "second click") opens the raw file in
        a new tab. Esc / backdrop / close-button all dismiss. */}
    <div id="lightbox" class="lightbox" aria-hidden="true" role="dialog">
      <button id="lightbox-close" class="lightbox-close" type="button" aria-label="Close">×</button>
      <a id="lightbox-link" class="lightbox-link" href="#" target="_blank" rel="noopener" title="Open full size in new tab">
        <img id="lightbox-img" alt="" />
      </a>
    </div>

    <div class="shell">
      <Sidebar activeSlug={activeSlug} />
      <main class="content">
        <div class="content-inner">
          <article class="prose">
            <slot />
          </article>
        </div>
      </main>
    </div>

    <script>
      const body = document.body;
      const toggle = document.getElementById('nav-toggle');
      const backdrop = document.getElementById('backdrop');

      function setOpen(open: boolean) {
        body.classList.toggle('sidebar-open', open);
        toggle?.setAttribute('aria-expanded', String(open));
      }
      function close() { setOpen(false); }

      toggle?.addEventListener('click', () => setOpen(!body.classList.contains('sidebar-open')));
      backdrop?.addEventListener('click', close);

      // Close on Escape
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && body.classList.contains('sidebar-open')) close();
      });

      // Close on any sidebar link click (mobile UX — sidebar collapses
      // before navigation kicks in, so the next page lands clean).
      document.querySelectorAll('aside.sidebar a.nav-item').forEach((a) => {
        a.addEventListener('click', close);
      });

      // ── Lightbox ──────────────────────────────────────────────────
      const lb = document.getElementById('lightbox') as HTMLElement | null;
      const lbImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
      const lbLink = document.getElementById('lightbox-link') as HTMLAnchorElement | null;
      const lbClose = document.getElementById('lightbox-close');

      function openLightbox(src: string, alt: string) {
        if (!lb || !lbImg || !lbLink) return;
        lbImg.src = src;
        lbImg.alt = alt;
        lbLink.href = src;
        lb.classList.add('open');
        lb.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }
      function closeLightbox() {
        if (!lb) return;
        lb.classList.remove('open');
        lb.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      document.querySelectorAll('article.prose img').forEach((el) => {
        const img = el as HTMLImageElement;
        img.classList.add('zoomable');
        img.addEventListener('click', () => openLightbox(img.src, img.alt));
      });

      lb?.addEventListener('click', (e) => {
        // Click on backdrop closes; click bubbling from the anchor/img is
        // ignored here (anchor's target=_blank handles "open in new tab").
        if (e.target === lb) closeLightbox();
      });
      lbClose?.addEventListener('click', closeLightbox);

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && lb?.classList.contains('open')) closeLightbox();
      });
    </script>

    <style>
      .shell { display: flex; min-height: 100vh; }
      .content { flex: 1; min-width: 0; }
      .content-inner {
        max-width: 860px;
        margin: 0 auto;
        padding: 40px 48px;
      }
      /* Widen the reading column on larger screens — capped so line length
         stays readable (we never go past ~80ch even on a 4K display). */
      @media (min-width: 1280px) {
        .content-inner { max-width: 1040px; }
      }
      @media (min-width: 1536px) {
        .content-inner { max-width: 1200px; padding: 48px 64px; }
      }

      /* ── Mobile-only topbar ──────────────────────────────────────── */
      .topbar {
        display: none;
        align-items: center;
        gap: 12px;
        padding: 10px 16px;
        position: sticky;
        top: 0;
        z-index: 80;
        background: theme('colors.sidebar.DEFAULT');
        border-bottom: 1px solid theme('colors.divider.DEFAULT');
      }
      :global(html.light) .topbar {
        background: theme('colors.sidebar.light');
        border-color: theme('colors.divider.light');
      }
      .hamburger {
        background: none;
        border: 0;
        cursor: pointer;
        padding: 6px;
        color: theme('colors.ink.DEFAULT');
        display: inline-flex;
        border-radius: 6px;
      }
      :global(html.light) .hamburger { color: theme('colors.ink.light'); }
      .hamburger:hover { background: theme('colors.sidebar.hover'); }
      :global(html.light) .hamburger:hover { background: theme('colors.sidebar.hover-light'); }
      .topbar-logo {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
      }
      .topbar-mark {
        width: 24px; height: 24px;
        display: inline-flex; align-items: center; justify-content: center;
        border-radius: 6px;
        background: linear-gradient(135deg, theme('colors.brand.DEFAULT'), theme('colors.brand.dim'));
        font-size: 14px;
        color: #000;
      }
      .topbar-name {
        color: theme('colors.ink.DEFAULT');
        font-weight: 700;
        font-size: 16px;
        letter-spacing: 0.3px;
      }
      :global(html.light) .topbar-name { color: theme('colors.ink.light'); }

      /* ── Tap-to-close backdrop ───────────────────────────────────── */
      .backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.55);
        z-index: 90;
        opacity: 0;
        pointer-events: none;
        transition: opacity 200ms ease;
      }
      :global(body.sidebar-open) .backdrop {
        opacity: 1;
        pointer-events: auto;
      }

      @media (max-width: 768px) {
        .topbar { display: flex; }
        .content-inner { padding: 24px 18px; }
        /* Lock body scroll behind the open drawer. */
        :global(body.sidebar-open) {
          overflow: hidden;
        }
      }

      /* ── Side-by-side panel row for demo screenshots ─────────────── */
      :global(article.prose .topic-row) {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin: 24px 0;
        align-items: start;
      }
      :global(article.prose .topic-row > div) {
        display: flex;
        flex-direction: column;
      }
      :global(article.prose .topic-row p) {
        font-size: 0.85rem;
        margin: 8px 0 0;
        line-height: 1.55;
      }
      :global(article.prose .topic-row img) {
        width: 100%;
        height: auto;
        align-self: start;
      }
      @media (max-width: 1100px) {
        :global(article.prose .topic-row) { grid-template-columns: repeat(2, 1fr); }
      }
      @media (max-width: 600px) {
        :global(article.prose .topic-row) { grid-template-columns: 1fr; }
      }

      /* ── Zoomable inline images ──────────────────────────────────── */
      :global(article.prose img.zoomable) {
        cursor: zoom-in;
        border-radius: 8px;
        transition: transform 150ms ease;
      }
      @media (hover: hover) {
        :global(article.prose img.zoomable:hover) { transform: scale(1.02); }
      }

      /* ── Lightbox overlay ────────────────────────────────────────── */
      .lightbox {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.88);
        z-index: 100;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 40px;
        cursor: zoom-out;
      }
      .lightbox.open { display: flex; }
      .lightbox-link {
        display: block;
        max-width: 100%;
        max-height: 100%;
        cursor: zoom-in;
      }
      .lightbox-link img {
        max-width: 100%;
        max-height: calc(100vh - 80px);
        display: block;
        border-radius: 8px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
      }
      .lightbox-close {
        position: absolute;
        top: 16px;
        right: 16px;
        width: 40px;
        height: 40px;
        border: 0;
        background: rgba(255, 255, 255, 0.08);
        color: #fff;
        font-size: 28px;
        line-height: 1;
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .lightbox-close:hover { background: rgba(255, 255, 255, 0.18); }
      @media (max-width: 768px) {
        .lightbox { padding: 16px; }
      }
    </style>
  </body>
</html>
