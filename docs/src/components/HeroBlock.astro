---
import IqDial from './IqDial.astro';
const base = import.meta.env.BASE_URL;
---
<section class="hero">
  <div class="hero-text">
    <div class="hero-pill">♫  ROCKY IQ</div>
    <h1 class="hero-h1">What's your Rocky IQ?</h1>
    <p class="hero-sub">
      A live 0–100 score of how well you actually understand the code your AI is shipping.
      Decays when you stop engaging. Climbs when you can answer for it.
    </p>
    <div class="hero-cta">
      <a class="hero-btn primary" href={`${base}installation/`}>Install Rocky&nbsp;&nbsp;→</a>
      <a class="hero-btn secondary" href="#why-it-exists">Learn more&nbsp;&nbsp;↓</a>
    </div>
    <p class="hero-foot">
      Free, local, open source. Plugs into Claude Code, your browser, and your git history.
    </p>
  </div>
  <div class="hero-dial">
    <IqDial target={74} />
  </div>
</section>

<style>
  .hero {
    display: flex;
    align-items: center;
    gap: 32px;
    padding: 8px 0 40px;
    margin-bottom: 32px;
    border-bottom: 1px solid theme('colors.divider.DEFAULT');
  }
  :global(html.light) .hero { border-color: theme('colors.divider.light'); }

  .hero-text { flex: 5; min-width: 0; }
  .hero-dial { flex-shrink: 0; }

  @media (max-width: 900px) {
    .hero { flex-direction: column; align-items: flex-start; }
    .hero-dial { align-self: center; margin-top: 16px; }
  }

  .hero-pill {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 99px;
    background: rgba(245, 158, 11, 0.12);
    color: theme('colors.brand.DEFAULT');
    border: 1px solid rgba(245, 158, 11, 0.3);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.2px;
    margin-bottom: 20px;
  }

  .hero-h1 {
    font-size: 44px;
    line-height: 1.1;
    font-weight: 800;
    letter-spacing: -1px;
    color: theme('colors.ink.DEFAULT');
    margin: 0 0 16px;
  }
  :global(html.light) .hero-h1 { color: theme('colors.ink.light'); }

  @media (max-width: 900px) {
    .hero-h1 { font-size: 36px; }
  }

  .hero-sub {
    font-size: 16px;
    line-height: 1.6;
    color: theme('colors.ink.mute');
    margin: 0 0 24px;
  }
  :global(html.light) .hero-sub { color: theme('colors.ink.mute-light'); }

  .hero-cta { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 20px; }
  .hero-btn {
    padding: 13px 18px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.2px;
    text-decoration: none;
    transition: background 150ms ease, color 150ms ease;
    border: 1px solid transparent;
  }
  .hero-btn.primary {
    background: theme('colors.brand.DEFAULT');
    color: #000;
  }
  .hero-btn.primary:hover { background: theme('colors.brand.dim'); }
  .hero-btn.secondary {
    color: theme('colors.ink.DEFAULT');
    border-color: theme('colors.divider.DEFAULT');
  }
  :global(html.light) .hero-btn.secondary { color: theme('colors.ink.light'); border-color: theme('colors.divider.light'); }
  .hero-btn.secondary:hover { background: theme('colors.sidebar.hover'); }
  :global(html.light) .hero-btn.secondary:hover { background: theme('colors.sidebar.hover-light'); }

  .hero-foot {
    font-size: 13px;
    line-height: 1.5;
    color: theme('colors.ink.dim');
    margin: 0;
  }
  :global(html.light) .hero-foot { color: theme('colors.ink.dim-light'); }
</style>
