---
import { sections } from '../data/sections';
const { activeSlug } = Astro.props as { activeSlug?: string };
const base = import.meta.env.BASE_URL; // "/rocky/"
---
<aside class="sidebar">
  <a href={base} class="logo-row">
    <span class="logo-mark">🪨</span>
    <span class="logo-text">Rocky</span>
    <span class="logo-pill">docs</span>
  </a>
  <p class="tagline">You Observe. Question?</p>

  <nav class="nav">
    {sections.map(s => (
      <a
        href={`${base}${s.slug}/`}
        class:list={['nav-item', { active: s.slug === activeSlug }]}
      >
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path fill="currentColor" d={s.icon} />
        </svg>
        <span>{s.title}</span>
      </a>
    ))}
  </nav>

  <div class="sidebar-footer">
    <a href="https://github.com/NVME-git/rocky" class="gh-link" rel="noopener">
      <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
        <path fill="currentColor" d="M12 2A10 10 0 002 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.7c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.1.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.5 9.5 0 015 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.69 0 3.84-2.34 4.69-4.57 4.94.36.31.69.92.69 1.85V21c0 .27.16.59.67.5A10 10 0 0022 12 10 10 0 0012 2z" />
      </svg>
      <span>GitHub</span>
    </a>
    <button id="theme-toggle" class="theme-btn" type="button" aria-label="Toggle theme">
      <svg id="theme-icon-dark" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path fill="currentColor" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/>
      </svg>
      <svg id="theme-icon-light" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" style="display:none">
        <path fill="currentColor" d="M6.76 4.84l-1.8-1.79-1.41 1.41 1.79 1.8 1.42-1.42zM4 11H1v2h3v-2zm9-9h-2v3h2V2zm7.45 3.46l-1.41-1.41-1.8 1.79 1.42 1.42 1.79-1.8zM17.24 19.16l1.79 1.8 1.41-1.41-1.79-1.8-1.41 1.41zM20 11v2h3v-2h-3zM12 5a7 7 0 100 14 7 7 0 000-14zm-1 17h2v-3h-2v3zM4.96 19.95l1.41 1.41 1.79-1.79-1.41-1.41-1.79 1.79z"/>
      </svg>
    </button>
  </div>
</aside>

<script>
  // Theme toggle: persists to localStorage, applies class to <html>.
  const KEY = 'rocky-theme';
  const html = document.documentElement;
  const dark = document.getElementById('theme-icon-dark') as HTMLElement | null;
  const light = document.getElementById('theme-icon-light') as HTMLElement | null;
  const btn = document.getElementById('theme-toggle');

  function paint() {
    const isLight = html.classList.contains('light');
    if (dark)  dark.style.display  = isLight ? 'none' : 'block';
    if (light) light.style.display = isLight ? 'block' : 'none';
  }
  function set(theme: 'dark' | 'light') {
    if (theme === 'light') html.classList.add('light'); else html.classList.remove('light');
    localStorage.setItem(KEY, theme);
    paint();
  }
  paint();
  btn?.addEventListener('click', () => set(html.classList.contains('light') ? 'dark' : 'light'));
</script>

<style>
  .sidebar {
    width: 280px;
    flex-shrink: 0;
    background: theme('colors.sidebar.DEFAULT');
    border-right: 1px solid theme('colors.divider.DEFAULT');
    padding: 24px 0;
    display: flex; flex-direction: column;
    height: 100vh;
    position: sticky; top: 0;
  }
  :global(html.light) .sidebar { background: theme('colors.sidebar.light'); border-color: theme('colors.divider.light'); }

  .logo-row {
    display: flex; align-items: center; gap: 12px;
    padding: 0 24px 0;
    text-decoration: none;
  }
  .logo-mark {
    width: 32px; height: 32px;
    display: inline-flex; align-items: center; justify-content: center;
    border-radius: 8px;
    background: linear-gradient(135deg, theme('colors.brand.DEFAULT'), theme('colors.brand.dim'));
    font-size: 16px;
  }
  .logo-text { color: theme('colors.ink.DEFAULT'); font-weight: 700; font-size: 20px; letter-spacing: 0.5px; }
  :global(html.light) .logo-text { color: theme('colors.ink.light'); }
  .logo-pill {
    padding: 2px 6px;
    border-radius: 4px;
    background: rgba(245, 158, 11, 0.15);
    color: theme('colors.brand.DEFAULT');
    font-size: 11px; font-weight: 600;
  }

  .tagline {
    padding: 8px 24px 0;
    color: theme('colors.ink.dim');
    font-size: 12px;
    letter-spacing: 0.5px;
  }
  :global(html.light) .tagline { color: theme('colors.ink.dim-light'); }

  .nav {
    margin-top: 24px;
    padding: 0 12px;
    flex: 1;
    overflow-y: auto;
    display: flex; flex-direction: column; gap: 2px;
    border-top: 1px solid theme('colors.divider.DEFAULT');
    padding-top: 12px;
  }
  :global(html.light) .nav { border-color: theme('colors.divider.light'); }

  .nav-item {
    display: flex; align-items: center; gap: 12px;
    padding: 8px 12px;
    border-radius: 6px;
    color: theme('colors.ink.mute');
    text-decoration: none;
    font-size: 14px;
    transition: background 120ms ease, color 120ms ease;
  }
  :global(html.light) .nav-item { color: theme('colors.ink.mute-light'); }
  .nav-item:hover { background: theme('colors.sidebar.hover'); }
  :global(html.light) .nav-item:hover { background: theme('colors.sidebar.hover-light'); }
  .nav-item.active {
    background: rgba(245, 158, 11, 0.12);
    color: theme('colors.brand.DEFAULT');
  }

  .sidebar-footer {
    border-top: 1px solid theme('colors.divider.DEFAULT');
    padding: 16px 24px;
    display: flex; align-items: center; gap: 8px;
  }
  :global(html.light) .sidebar-footer { border-color: theme('colors.divider.light'); }
  .gh-link {
    display: inline-flex; align-items: center; gap: 8px;
    color: theme('colors.ink.dim');
    font-size: 12px;
    text-decoration: none;
  }
  :global(html.light) .gh-link { color: theme('colors.ink.dim-light'); }
  .gh-link:hover { color: theme('colors.ink.mute'); }
  :global(html.light) .gh-link:hover { color: theme('colors.ink.mute-light'); }

  .theme-btn {
    margin-left: auto;
    background: none; border: none;
    padding: 6px;
    cursor: pointer;
    color: theme('colors.ink.dim');
    border-radius: 20px;
    display: inline-flex;
    transition: color 150ms ease;
  }
  :global(html.light) .theme-btn { color: theme('colors.ink.dim-light'); }
  .theme-btn:hover { color: theme('colors.ink.mute'); }
  :global(html.light) .theme-btn:hover { color: theme('colors.ink.mute-light'); }
</style>
